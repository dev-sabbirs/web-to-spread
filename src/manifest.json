{
  "name": "WebToSpread - Lead Extractor & Sync",
  "{{chrome}}.manifest_version": 3,
  "{{firefox}}.manifest_version": 2,
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "{{chrome}}.action": {
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "96": "icon/96.png",
      "128": "icon/128.png"
    }
  },
  "{{chrome}}.options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "{{chrome}}.service_worker": "src/background.ts",
    "{{firefox}}.scripts": ["src/background.ts"]
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://github.com/*",
    "https://*.linkedin.com/*",
    "https://script.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.linkedin.com/*"
      ],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon/128.png", "icon/*.png"],
      "matches": ["https://github.com/*", "https://*.linkedin.com/*"]
    }
  ]
}
